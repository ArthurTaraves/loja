# Firebase — copie em Project settings > General > Your apps (Web app) no console do Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — crie um upload preset do tipo "unsigned" em Settings > Upload > Upload presets
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Firebase App Check (opcional) — protege o Firestore contra bots/abuso fora do
# seu site. Deixe vazio pra rodar sem App Check (nada quebra). Veja o README
# pra criar a chave do reCAPTCHA v3 e ativar o App Check no console.
VITE_RECAPTCHA_SITE_KEY=
